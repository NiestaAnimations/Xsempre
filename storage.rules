rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAlbumMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid in [
          "4l9aA6AOKpMr7dv0yMZplbDuZ7c2"
        ];
    }

    match /photos/{photoId} {
      allow read: if isAlbumMember();
      allow create: if isAlbumMember()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.metadata.ownerUid == request.auth.uid;
      allow delete: if isAlbumMember()
        && resource.metadata.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
